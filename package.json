{
  "name": "live-interpreter",
  "version": "2.5.0",
  "private": true,
  "license": "MIT",
  "description": "Live speech translation for Microsoft Teams, Google Meet and Zoom on the web, and any video or radio tab, as a browser extension; Claude, Ollama or free translation, ElevenLabs or a self-hosted speech server",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "build:test": "node scripts/build.mjs --test",
    "watch": "node scripts/build.mjs --watch",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "node scripts/build.mjs --test && node test/e2e/run.mjs",
    "test:scenarios": "node scripts/build.mjs --test && node test/e2e/scenarios.mjs",
    "test:api": "node test/api/smoke.mjs",
    "test:free": "node test/api/free.mjs",
    "test:soniox": "node test/api/soniox.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "ws": "^8.18.3"
  }
}
